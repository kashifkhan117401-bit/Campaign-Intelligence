# =============================================================================
# Campaign Intelligence - Environment Configuration
# Copy this file to .env and populate your credentials.
# Never commit real .env files or secrets to version control.
# =============================================================================

# Application
APP_NAME=Campaign Intelligence
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security & Authentication (Generate strong random values in production)
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CAPTCHA_ENABLED=true
# Fernet 32-byte url-safe base64 key for encrypting OAuth tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Database
# PostgreSQL (Recommended for production & Docker Compose):
# DATABASE_URL=postgresql+psycopg://tubemind:tubemind_pass@db:5432/tubemind
# SQLite (Convenient local development fallback):
DATABASE_URL=sqlite:///./tubemind.db

# AI / LLM Configuration (Google Gemini default; OpenAI optional)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=
TRANSCRIPTION_PROVIDER=gemini

# Optional OpenAI / OpenAI-Compatible Configuration (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=
# WHISPER_MODEL=whisper-1

# YouTube Data API v3 & Google OAuth 2.0
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Development Demo Mode
# When true AND external API keys (YouTube / Gemini) are missing,
# visibly labeled demo data can be used for local testing.
# Set to false in production.
ALLOW_DEMO_MODE=true

# File Storage & Upload Limits
UPLOAD_DIR=./storage/uploads
REPORTS_DIR=./storage/reports
FRAMES_DIR=./storage/frames
MAX_VIDEO_UPLOAD_MB=500

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ANALYSIS_MAX_COMMENTS=2000
ANALYSIS_BATCH_SIZE=50
